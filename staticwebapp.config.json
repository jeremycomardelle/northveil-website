{
  "routes": [
    { "route": "/about-us", "rewrite": "/about-us/index.html" },
    { "route": "/questions", "rewrite": "/questions/index.html" }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/css/*", "/js/*", "/assets/*", "/*.{png,jpg,jpeg,svg,gif,webp,ico,mp4,webm}"]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
